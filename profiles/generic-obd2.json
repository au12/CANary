{
  "schema": 1,
  "id": "generic-obd2",
  "name": "Generic OBD-II",
  "description": "Works on any 2008+ petrol or diesel car with CAN OBD-II. Standard PIDs only; the car is asked which ones it supports.",
  "can": { "bitrate": 0, "id_bits": 0 },
  "ecus": {},
  "signals": [
    { "id": "rpm", "name": "Engine speed", "unit": "rpm", "group": "engine", "rate": "fast", "dec": 0, "min": 0, "max": 12000,
      "src": [ { "obd": "0C", "len": 16, "div": 4 } ] },
    { "id": "speed", "name": "Vehicle speed", "unit": "km/h", "group": "engine", "rate": "fast", "dec": 0, "min": 0, "max": 400,
      "src": [ { "obd": "0D" } ] },
    { "id": "engine_load", "name": "Engine load", "unit": "%", "group": "engine", "rate": "fast", "dec": 0,
      "src": [ { "obd": "04", "mul": 100, "div": 255 } ] },
    { "id": "accel_pedal", "name": "Accelerator pedal", "unit": "%", "group": "engine", "rate": "fast", "dec": 0,
      "src": [ { "obd": "49", "mul": 100, "div": 255 }, { "obd": "5A", "mul": 100, "div": 255 }, { "obd": "11", "mul": 100, "div": 255 } ] },
    { "id": "throttle", "name": "Throttle position", "unit": "%", "group": "engine", "rate": "medium", "dec": 0,
      "src": [ { "obd": "11", "mul": 100, "div": 255 } ] },
    { "id": "timing_advance", "name": "Ignition timing advance", "unit": "°", "group": "ignition", "rate": "fast", "dec": 1,
      "src": [ { "obd": "0E", "div": 2, "add": -64 } ] },
    { "id": "coolant_temp", "name": "Coolant temperature", "unit": "°C", "group": "temperatures", "rate": "slow", "dec": 0, "min": -40, "max": 215,
      "src": [ { "obd": "05", "add": -40 } ] },
    { "id": "intake_air_temp", "name": "Intake air temperature", "unit": "°C", "group": "temperatures", "rate": "slow", "dec": 0, "min": -40, "max": 215,
      "src": [ { "obd": "0F", "add": -40 } ] },
    { "id": "ambient_temp", "name": "Outside air temperature", "unit": "°C", "group": "temperatures", "rate": "rare", "dec": 0, "min": -40, "max": 80,
      "src": [ { "obd": "46", "add": -40 } ] },
    { "id": "oil_temp", "name": "Engine oil temperature", "unit": "°C", "group": "temperatures", "rate": "slow", "dec": 0, "min": -40, "max": 215,
      "src": [ { "obd": "5C", "add": -40 } ] },
    { "id": "charge_air_temp", "name": "Charge air temperature", "unit": "°C", "group": "temperatures", "rate": "slow", "dec": 0, "min": -40, "max": 215,
      "src": [ { "obd": "77", "bit": 8, "add": -40 } ] },
    { "id": "cat_temp", "name": "Catalyst temperature", "unit": "°C", "group": "temperatures", "rate": "slow", "dec": 0,
      "src": [ { "obd": "3C", "len": 16, "div": 10, "add": -40 } ] },
    { "id": "map", "name": "Intake manifold pressure", "unit": "kPa", "group": "boost", "rate": "fast", "dec": 0,
      "src": [ { "obd": "0B" } ] },
    { "id": "baro", "name": "Barometric pressure", "unit": "kPa", "group": "boost", "rate": "rare", "dec": 0, "min": 50, "max": 115,
      "src": [ { "obd": "33" } ] },
    { "id": "boost_actual", "name": "Boost pressure (actual, absolute)", "unit": "kPa", "group": "boost", "rate": "fast", "dec": 1,
      "src": [ { "obd": "70", "bit": 24, "len": 16, "div": 32 }, { "obd": "0B" } ] },
    { "id": "boost_target", "name": "Boost pressure (target, absolute)", "unit": "kPa", "group": "boost", "rate": "fast", "dec": 1,
      "src": [ { "obd": "70", "bit": 8, "len": 16, "div": 32 } ] },
    { "id": "boost", "name": "Boost (above atmosphere)", "unit": "kPa", "group": "boost", "rate": "fast", "dec": 1,
      "src": [ { "calc": "boost_actual - baro" } ] },
    { "id": "maf", "name": "Mass air flow", "unit": "g/s", "group": "engine", "rate": "fast", "dec": 1,
      "src": [ { "obd": "10", "len": 16, "div": 100 } ] },
    { "id": "stft_b1", "name": "Short-term fuel trim, bank 1", "unit": "%", "group": "fuel", "rate": "fast", "dec": 1,
      "src": [ { "obd": "06", "mul": 100, "div": 128, "add": -100 } ] },
    { "id": "ltft_b1", "name": "Long-term fuel trim, bank 1", "unit": "%", "group": "fuel", "rate": "medium", "dec": 1,
      "src": [ { "obd": "07", "mul": 100, "div": 128, "add": -100 } ] },
    { "id": "stft_b2", "name": "Short-term fuel trim, bank 2", "unit": "%", "group": "fuel", "rate": "fast", "dec": 1,
      "src": [ { "obd": "08", "mul": 100, "div": 128, "add": -100 } ] },
    { "id": "ltft_b2", "name": "Long-term fuel trim, bank 2", "unit": "%", "group": "fuel", "rate": "medium", "dec": 1,
      "src": [ { "obd": "09", "mul": 100, "div": 128, "add": -100 } ] },
    { "id": "fuel_trim_b1", "name": "Total fuel trim, bank 1", "unit": "%", "group": "fuel", "rate": "fast", "dec": 1,
      "src": [ { "calc": "stft_b1 + ltft_b1" } ] },
    { "id": "fuel_trim_b2", "name": "Total fuel trim, bank 2", "unit": "%", "group": "fuel", "rate": "fast", "dec": 1,
      "src": [ { "calc": "stft_b2 + ltft_b2" } ] },
    { "id": "lambda_cmd", "name": "Commanded lambda", "unit": "λ", "group": "fuel", "rate": "medium", "dec": 3,
      "src": [ { "obd": "44", "len": 16, "div": 32768 } ] },
    { "id": "lambda", "name": "Measured lambda (sensor 1)", "unit": "λ", "group": "fuel", "rate": "medium", "dec": 3,
      "src": [ { "obd": "34", "len": 16, "div": 32768 }, { "obd": "24", "len": 16, "div": 32768 } ] },
    { "id": "rail_pressure", "name": "Fuel rail pressure", "unit": "kPa", "group": "fuel", "rate": "fast", "dec": 0,
      "src": [ { "obd": "59", "len": 16, "mul": 10 }, { "obd": "23", "len": 16, "mul": 10 } ] },
    { "id": "fuel_level", "name": "Fuel level", "unit": "%", "group": "fuel", "rate": "rare", "dec": 0,
      "src": [ { "obd": "2F", "mul": 100, "div": 255 } ] },
    { "id": "fuel_rate", "name": "Fuel rate", "unit": "L/h", "group": "fuel", "rate": "medium", "dec": 2,
      "src": [ { "obd": "5E", "len": 16, "div": 20 } ] },
    { "id": "ethanol", "name": "Ethanol content", "unit": "%", "group": "fuel", "rate": "rare", "dec": 0,
      "src": [ { "obd": "52", "mul": 100, "div": 255 } ] },
    { "id": "vbat", "name": "Battery voltage", "unit": "V", "group": "electrical", "rate": "medium", "dec": 2, "min": 5, "max": 18,
      "src": [ { "device": "vbat" }, { "obd": "42", "len": 16, "div": 1000 } ] },
    { "id": "ecu_voltage", "name": "Control module voltage", "unit": "V", "group": "electrical", "rate": "slow", "dec": 2,
      "src": [ { "obd": "42", "len": 16, "div": 1000 } ] },
    { "id": "mil", "name": "Check engine light", "unit": "", "group": "status", "rate": "slow", "dec": 0,
      "src": [ { "obd": "01", "bit": 0, "len": 1 } ] },
    { "id": "dtc_count", "name": "Emission-related trouble codes", "unit": "", "group": "status", "rate": "slow", "dec": 0,
      "src": [ { "obd": "01", "bit": 1, "len": 7 } ] },
    { "id": "clr_dist", "name": "Distance since codes cleared", "unit": "km", "group": "status", "rate": "rare", "dec": 0,
      "src": [ { "obd": "31", "len": 16 } ] },
    { "id": "warmups", "name": "Warm-ups since codes cleared", "unit": "", "group": "status", "rate": "rare", "dec": 0,
      "src": [ { "obd": "30" } ] },
    { "id": "mil_dist", "name": "Distance with check engine light on", "unit": "km", "group": "status", "rate": "rare", "dec": 0,
      "src": [ { "obd": "21", "len": 16 } ] },
    { "id": "run_time", "name": "Time since engine start", "unit": "s", "group": "status", "rate": "slow", "dec": 0, "log": false,
      "src": [ { "obd": "1F", "len": 16 } ] },
    { "id": "odometer", "name": "Odometer", "unit": "km", "group": "status", "rate": "rare", "dec": 0, "min": 1, "max": 2000000,
      "src": [ { "obd": "A6", "len": 32, "div": 10 } ] },
    { "id": "trip_time", "name": "Trip time", "unit": "s", "group": "status", "rate": "medium", "dec": 0, "log": false,
      "src": [ { "device": "trip_time" } ] }
  ],
  "monitors": [
    { "id": "coolant_overheat", "title": "Engine running hot", "category": "Cooling",
      "when": "rpm > 400", "value": "coolant_temp", "stat": "max", "min_time_s": 60, "unit": "°C", "dec": 0,
      "levels": [ { "severity": "critical", "gt": 120 }, { "severity": "warning", "gt": 113 } ],
      "summary": "Coolant reached {value} °C.",
      "ok": "Coolant peaked at {value} °C, within the normal range.",
      "detail": "Sustained temperatures this high risk head-gasket and turbo damage. Stop and let the engine cool if the gauge or a warning confirms it.",
      "causes": [ "Low coolant level or a leak", "Failing water pump or thermostat housing", "Cooling fan not running", "Blocked radiator" ] },
    { "id": "warmup_slow", "title": "Slow to warm up", "category": "Cooling",
      "when": "rpm > 400", "value": "coolant_temp >= 75", "stat": "time_to", "min_time_s": 600, "unit": "s", "dec": 0,
      "levels": [ { "severity": "warning", "gt": 1500 }, { "severity": "advisory", "gt": 1080 } ],
      "summary": "The engine needed more than {value} s to reach 75 °C.",
      "ok": "Reached operating temperature in {value} s.",
      "detail": "An engine that stays cold burns more fuel, wears faster and can hold back boost. Short winter trips can trigger this without a fault.",
      "causes": [ "Thermostat stuck open", "Coolant temperature sensor reading low", "Very short trips in cold weather" ] },
    { "id": "fuel_trim_idle_lean", "title": "Running lean at idle", "category": "Fuel mixture",
      "when": "rpm > 500 && rpm < 1100 && speed < 3 && coolant_temp > 70", "value": "fuel_trim_b1", "stat": "mean", "settle_s": 3, "min_time_s": 30, "unit": "%", "dec": 1,
      "levels": [ { "severity": "warning", "gt": 15 }, { "severity": "advisory", "gt": 9 } ],
      "summary": "The engine is adding {value} % fuel at idle to keep the mixture right.",
      "ok": "Idle fuel trim is {value} %.",
      "detail": "Extra fuel at idle that fades as load rises points to air getting in after the air meter. Left alone it leads to rough idle and lean codes (P0171).",
      "causes": [ "Vacuum or intake leak (hoses, PCV valve, intake manifold gasket)", "Leaking brake booster line", "Dirty or failing air mass / pressure sensor", "Exhaust leak ahead of the oxygen sensor" ] },
    { "id": "fuel_trim_idle_rich", "title": "Running rich at idle", "category": "Fuel mixture",
      "when": "rpm > 500 && rpm < 1100 && speed < 3 && coolant_temp > 70", "value": "fuel_trim_b1", "stat": "mean", "settle_s": 3, "min_time_s": 30, "unit": "%", "dec": 1,
      "levels": [ { "severity": "warning", "lt": -15 }, { "severity": "advisory", "lt": -9 } ],
      "summary": "The engine is pulling {value} % fuel at idle.",
      "ok": "Idle fuel trim is {value} %.",
      "detail": "The engine is getting more fuel than it asks for at idle.",
      "causes": [ "Leaking injector", "Purge valve stuck open", "Fuel in the oil from many short trips", "Air sensor reading high" ] },
    { "id": "fuel_trim_load_lean", "title": "Running lean under load", "category": "Fuel mixture",
      "when": "engine_load > 60 && rpm > 2000 && coolant_temp > 70", "value": "fuel_trim_b1", "stat": "mean", "settle_s": 1, "min_time_s": 12, "unit": "%", "dec": 1,
      "levels": [ { "severity": "critical", "gt": 22 }, { "severity": "warning", "gt": 14 }, { "severity": "advisory", "gt": 9 } ],
      "summary": "The engine is adding {value} % fuel under load.",
      "ok": "Fuel trim under load is {value} %.",
      "detail": "Needing extra fuel when working hard means fuel delivery is not keeping up, or the engine is under-reading its air. Lean under load is the dangerous direction for a turbo engine.",
      "causes": [ "Weak fuel pump or clogged filter", "High-pressure pump or its cam follower wearing", "Air mass sensor under-reading", "Boost leak after the air meter" ] },
    { "id": "fuel_trim_load_rich", "title": "Running rich under load", "category": "Fuel mixture",
      "when": "engine_load > 60 && rpm > 2000 && coolant_temp > 70", "value": "fuel_trim_b1", "stat": "mean", "settle_s": 1, "min_time_s": 12, "unit": "%", "dec": 1,
      "levels": [ { "severity": "warning", "lt": -15 }, { "severity": "advisory", "lt": -10 } ],
      "summary": "The engine is pulling {value} % fuel under load.",
      "ok": "Fuel trim under load is {value} %.",
      "detail": "The engine is getting more fuel than it asks for when working hard.",
      "causes": [ "Leaking or over-delivering injector", "Fuel pressure too high", "Boost leak on engines that measure air by flow", "Air sensor reading high" ] },
    { "id": "fuel_trim_bank_split", "title": "Fuel trim differs between banks", "category": "Fuel mixture",
      "when": "coolant_temp > 70 && rpm > 500", "value": "abs(fuel_trim_b1 - fuel_trim_b2)", "stat": "mean", "min_time_s": 120, "unit": "%", "dec": 1,
      "levels": [ { "severity": "warning", "gt": 12 }, { "severity": "advisory", "gt": 7 } ],
      "summary": "The two cylinder banks differ by {value} % in fuel trim.",
      "ok": "Both banks agree within {value} %.",
      "detail": "A fault on one side only: one bank is compensating for something the other is not.",
      "causes": [ "Intake leak on one bank", "Injector or oxygen sensor on one bank", "Exhaust leak on one bank" ] },
    { "id": "boost_under_target", "title": "Boost below target", "category": "Boost",
      "when": "accel_pedal > 60 && rpm > 2000 && boost_target > baro + 35", "value": "boost_target - boost_actual", "stat": "p90", "settle_s": 2, "min_time_s": 6, "unit": "kPa", "dec": 1,
      "levels": [ { "severity": "critical", "gt": 35 }, { "severity": "warning", "gt": 20 }, { "severity": "advisory", "gt": 12 } ],
      "summary": "Boost fell {value} kPa short of what the engine asked for under hard acceleration.",
      "ok": "Boost tracks its target (worst shortfall {value} kPa).",
      "detail": "The turbo is not delivering the pressure requested. This often shows up here before a P0299 code or limp mode.",
      "causes": [ "Boost leak (charge pipes, couplers, intercooler)", "Diverter (recirculation) valve leaking", "Wastegate actuator or its control", "PCV valve failure", "Worn turbocharger" ] },
    { "id": "boost_over_target", "title": "Boost above target", "category": "Boost",
      "when": "accel_pedal > 60 && rpm > 2000 && boost_target > baro + 35", "value": "boost_actual - boost_target", "stat": "p90", "settle_s": 2, "min_time_s": 6, "unit": "kPa", "dec": 1,
      "levels": [ { "severity": "critical", "gt": 45 }, { "severity": "warning", "gt": 30 } ],
      "summary": "Boost overshot its target by {value} kPa.",
      "ok": "No boost overshoot (worst {value} kPa).",
      "detail": "More boost than requested stresses the engine and can trigger an overboost code (P0234).",
      "causes": [ "Wastegate sticking closed", "Boost control solenoid or its vacuum lines", "Boost pressure sensor" ] },
    { "id": "charge_temp_rise", "title": "Intake air much hotter than outside", "category": "Boost",
      "when": "speed > 50 && rpm > 1000", "value": "intake_air_temp - ambient_temp", "stat": "p90", "min_time_s": 120, "unit": "°C", "dec": 0,
      "levels": [ { "severity": "warning", "gt": 45 }, { "severity": "advisory", "gt": 32 } ],
      "summary": "Intake air ran {value} °C above outside temperature while moving.",
      "ok": "Intake air stays within {value} °C of outside temperature while moving.",
      "detail": "Hot intake air costs power and makes the engine pull ignition timing.",
      "causes": [ "Intercooler blocked or its airflow obstructed", "Heat soak after stop-and-go driving", "Intake temperature sensor fault" ] },
    { "id": "charging_low", "title": "Charging voltage low", "category": "Electrical",
      "when": "rpm > 1000", "value": "vbat", "stat": "p90", "min_time_s": 120, "unit": "V", "dec": 2,
      "levels": [ { "severity": "critical", "lt": 12.6 }, { "severity": "warning", "lt": 13.1 } ],
      "summary": "System voltage only reached {value} V with the engine running.",
      "ok": "Charging system reaches {value} V.",
      "detail": "The alternator is not lifting system voltage. Smart charging can hold voltage low for a while, so this looks at the upper end of what was seen.",
      "causes": [ "Alternator or its regulator", "Drive belt slipping", "Battery at end of life", "Poor ground or battery terminal connection" ] },
    { "id": "charging_high", "title": "Charging voltage high", "category": "Electrical",
      "when": "rpm > 1000", "value": "vbat", "stat": "p95", "min_time_s": 120, "unit": "V", "dec": 2,
      "levels": [ { "severity": "critical", "gt": 15.6 }, { "severity": "warning", "gt": 15.1 } ],
      "summary": "System voltage reached {value} V.",
      "ok": "No over-voltage (peak {value} V).",
      "detail": "Over-voltage cooks the battery and can damage electronics.",
      "causes": [ "Voltage regulator fault", "Battery sensor fault" ] },
    { "id": "oil_overheat", "title": "Oil temperature high", "category": "Lubrication",
      "when": "rpm > 400", "value": "oil_temp", "stat": "max", "min_time_s": 60, "unit": "°C", "dec": 0,
      "levels": [ { "severity": "critical", "gt": 140 }, { "severity": "warning", "gt": 130 } ],
      "summary": "Oil reached {value} °C.",
      "ok": "Oil peaked at {value} °C.",
      "detail": "Oil this hot thins out and breaks down quickly.",
      "causes": [ "Sustained high load or towing", "Low oil level", "Oil cooler or its coolant supply" ] },
    { "id": "catalyst_overheat", "title": "Catalyst temperature high", "category": "Exhaust",
      "when": "rpm > 400", "value": "cat_temp", "stat": "max", "min_time_s": 60, "unit": "°C", "dec": 0,
      "levels": [ { "severity": "critical", "gt": 980 }, { "severity": "warning", "gt": 920 } ],
      "summary": "The catalyst reached {value} °C.",
      "ok": "Catalyst peaked at {value} °C.",
      "detail": "Very high catalyst temperature usually means unburned fuel is reaching it.",
      "causes": [ "Misfires", "Rich mixture", "Sustained full-load driving" ] },
    { "id": "codes_cleared_recently", "title": "Trouble codes were cleared recently", "category": "Diagnostics",
      "when": "rpm > 400", "value": "clr_dist", "stat": "last", "min_time_s": 5, "unit": "km", "dec": 0,
      "levels": [ { "severity": "advisory", "lt": 80 } ],
      "summary": "Codes were cleared {value} km ago; the car has not finished re-checking itself.",
      "ok": "{value} km since codes were last cleared.",
      "detail": "After a clear (or a battery disconnect) the self-tests start over. A fault can be present without a code until they have run again.",
      "causes": [ "Battery was disconnected or replaced", "Codes were erased with a scan tool" ] }
  ]
}
