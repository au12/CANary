{
  "schema": 1,
  "id": "vw-ea888-gen3",
  "name": "Volkswagen EA888 Gen 3 (1.8 / 2.0 TSI)",
  "description": "Engine-specific readings for the EA888 Gen 3 and Gen 3B turbo petrol engines (Simos 18/19 engine control). Identifiers come from the OBDb community database; each car is asked which ones it answers, and the first source that works is used.",
  "extends": ["vw-mqb"],
  "signals": [
    { "id": "boost_actual",
      "src": [ { "uds": "202A", "ecu": "engine", "len": 16, "mul": 0.008 }, { "uds": "11F0", "ecu": "engine", "len": 16, "div": 128 }, { "uds": "1057", "ecu": "engine", "len": 16, "div": 10 } ] },
    { "id": "boost_target",
      "src": [ { "uds": "2029", "ecu": "engine", "len": 16, "mul": 0.008 } ] },
    { "id": "wastegate_duty", "name": "Boost actuator duty", "unit": "%", "group": "boost", "rate": "medium", "dec": 0, "min": -5, "max": 105,
      "src": [ { "uds": "16EE", "ecu": "engine", "len": 16, "sign": true, "mul": 0.0122068184 }, { "uds": "11CC", "ecu": "engine", "len": 16, "sign": true, "div": 100 } ] },
    { "id": "charge_air_temp",
      "src": [ { "uds": "149E", "ecu": "engine", "len": 8, "mul": 0.75, "add": -48 }, { "uds": "1798", "ecu": "engine", "len": 16, "sign": true, "mul": 0.1, "add": -273.1 } ] },
    { "id": "oil_temp",
      "src": [ { "uds": "202F", "ecu": "engine", "len": 16, "div": 10, "add": -273.1 }, { "uds": "11BE", "ecu": "engine", "len": 16, "div": 10, "add": -273.1 } ] },

    { "id": "knock_retard_c1", "name": "Knock retard, cylinder 1", "unit": "°", "group": "ignition", "rate": "fast", "dec": 2, "min": -20, "max": 20,
      "src": [ { "uds": "200A", "ecu": "engine", "len": 8, "mul": 0.375, "add": -48 }, { "uds": "13F2", "ecu": "engine", "len": 8, "mul": 0.375, "add": -48 } ] },
    { "id": "knock_retard_c2", "name": "Knock retard, cylinder 2", "unit": "°", "group": "ignition", "rate": "fast", "dec": 2, "min": -20, "max": 20,
      "src": [ { "uds": "200B", "ecu": "engine", "len": 8, "mul": 0.375, "add": -48 }, { "uds": "13F3", "ecu": "engine", "len": 8, "mul": 0.375, "add": -48 } ] },
    { "id": "knock_retard_c3", "name": "Knock retard, cylinder 3", "unit": "°", "group": "ignition", "rate": "fast", "dec": 2, "min": -20, "max": 20,
      "src": [ { "uds": "200C", "ecu": "engine", "len": 8, "mul": 0.375, "add": -48 }, { "uds": "13F4", "ecu": "engine", "len": 8, "mul": 0.375, "add": -48 } ] },
    { "id": "knock_retard_c4", "name": "Knock retard, cylinder 4", "unit": "°", "group": "ignition", "rate": "fast", "dec": 2, "min": -20, "max": 20,
      "src": [ { "uds": "200D", "ecu": "engine", "len": 8, "mul": 0.375, "add": -48 }, { "uds": "13F5", "ecu": "engine", "len": 8, "mul": 0.375, "add": -48 } ] },
    { "id": "knock_retard_worst", "name": "Knock retard, worst cylinder", "unit": "°", "group": "ignition", "rate": "fast", "dec": 2,
      "src": [ { "calc": "max(max(abs(knock_retard_c1), abs(knock_retard_c2)), max(abs(knock_retard_c3), abs(knock_retard_c4)))" } ] },
    { "id": "knock_retard_spread", "name": "Knock retard, spread between cylinders", "unit": "°", "group": "ignition", "rate": "fast", "dec": 2,
      "src": [ { "calc": "knock_retard_worst - min(min(abs(knock_retard_c1), abs(knock_retard_c2)), min(abs(knock_retard_c3), abs(knock_retard_c4)))" } ] },

    { "id": "misfire_c1", "name": "Misfires, cylinder 1", "unit": "", "group": "ignition", "rate": "medium", "dec": 0,
      "src": [ { "uds": "291D", "ecu": "engine", "len": 16 }, { "uds": "1147", "ecu": "engine", "len": 16 } ] },
    { "id": "misfire_c2", "name": "Misfires, cylinder 2", "unit": "", "group": "ignition", "rate": "medium", "dec": 0,
      "src": [ { "uds": "2920", "ecu": "engine", "len": 16 }, { "uds": "114A", "ecu": "engine", "len": 16 } ] },
    { "id": "misfire_c3", "name": "Misfires, cylinder 3", "unit": "", "group": "ignition", "rate": "medium", "dec": 0,
      "src": [ { "uds": "291E", "ecu": "engine", "len": 16 }, { "uds": "1150", "ecu": "engine", "len": 16 } ] },
    { "id": "misfire_c4", "name": "Misfires, cylinder 4", "unit": "", "group": "ignition", "rate": "medium", "dec": 0,
      "src": [ { "uds": "291F", "ecu": "engine", "len": 16 }, { "uds": "1151", "ecu": "engine", "len": 16 } ] },
    { "id": "misfire_total", "name": "Misfires, all cylinders", "unit": "", "group": "ignition", "rate": "medium", "dec": 0,
      "src": [ { "uds": "2904", "ecu": "engine", "len": 16 }, { "uds": "1146", "ecu": "engine", "len": 16 }, { "calc": "misfire_c1 + misfire_c2 + misfire_c3 + misfire_c4" } ] },

    { "id": "cam_in_actual", "name": "Intake cam position (actual)", "unit": "°", "group": "valve timing", "rate": "medium", "dec": 1,
      "src": [ { "uds": "201E", "ecu": "engine", "len": 16, "sign": true, "div": 10 }, { "uds": "136E", "ecu": "engine", "len": 16, "sign": true, "div": 125 } ] },
    { "id": "cam_in_target", "name": "Intake cam position (target)", "unit": "°", "group": "valve timing", "rate": "medium", "dec": 1,
      "src": [ { "uds": "201D", "ecu": "engine", "len": 16, "sign": true, "div": 10 }, { "uds": "1373", "ecu": "engine", "len": 16, "sign": true, "div": 125 } ] },
    { "id": "cam_ex_actual", "name": "Exhaust cam position (actual)", "unit": "°", "group": "valve timing", "rate": "medium", "dec": 1,
      "src": [ { "uds": "201A", "ecu": "engine", "len": 16, "sign": true, "div": 10 }, { "uds": "136C", "ecu": "engine", "len": 16, "sign": true, "div": 125 } ] },
    { "id": "cam_ex_target", "name": "Exhaust cam position (target)", "unit": "°", "group": "valve timing", "rate": "medium", "dec": 1,
      "src": [ { "uds": "2019", "ecu": "engine", "len": 16, "sign": true, "div": 10 }, { "uds": "1371", "ecu": "engine", "len": 16, "sign": true, "div": 125 } ] },
    { "id": "cam_adapt_in", "name": "Intake cam adaptation (chain stretch)", "unit": "°", "group": "valve timing", "rate": "rare", "dec": 2, "min": -20, "max": 20,
      "src": [ { "uds": "2021", "ecu": "engine", "len": 16, "sign": true, "div": 10 }, { "uds": "1125", "ecu": "engine", "len": 16, "sign": true, "div": 50 } ] },
    { "id": "cam_adapt_ex", "name": "Exhaust cam adaptation (chain stretch)", "unit": "°", "group": "valve timing", "rate": "rare", "dec": 2, "min": -20, "max": 20,
      "src": [ { "uds": "2023", "ecu": "engine", "len": 16, "sign": true, "div": 10 }, { "uds": "1128", "ecu": "engine", "len": 16, "sign": true, "div": 50 } ] },

    { "id": "rail_pressure",
      "src": [ { "uds": "2027", "ecu": "engine", "len": 16, "mul": 10 }, { "uds": "1169", "ecu": "engine", "len": 16, "sign": true, "mul": 10 } ] },
    { "id": "rail_pressure_target", "name": "Fuel rail pressure (target)", "unit": "kPa", "group": "fuel", "rate": "fast", "dec": 0,
      "src": [ { "uds": "116A", "ecu": "engine", "len": 16, "sign": true, "mul": 10 }, { "uds": "121E", "ecu": "engine", "len": 16, "sign": true, "mul": 10 } ] },
    { "id": "lp_fuel_pressure", "name": "Low-side fuel pressure", "unit": "kPa", "group": "fuel", "rate": "medium", "dec": 0,
      "src": [ { "uds": "2025", "ecu": "engine", "len": 16, "div": 10 }, { "uds": "11C8", "ecu": "engine", "len": 16, "div": 10 } ] },
    { "id": "lp_fuel_pressure_target", "name": "Low-side fuel pressure (target)", "unit": "kPa", "group": "fuel", "rate": "medium", "dec": 0,
      "src": [ { "uds": "11CE", "ecu": "engine", "len": 16, "div": 10 } ] },
    { "id": "engine_torque", "name": "Engine torque", "unit": "Nm", "group": "engine", "rate": "medium", "dec": 0,
      "src": [ { "uds": "1047", "ecu": "engine", "len": 16, "sign": true, "div": 10 }, { "uds": "2002", "ecu": "engine", "len": 16, "sign": true, "div": 10 } ] },
    { "id": "oil_level", "name": "Oil level (sensor)", "unit": "mm", "group": "lubrication", "rate": "rare", "dec": 1,
      "src": [ { "uds": "11BC", "ecu": "engine", "len": 16, "sign": true, "div": 250 } ] }
  ],
  "monitors": [
    { "id": "knock_retard", "title": "Engine pulling ignition timing", "category": "Ignition",
      "when": "accel_pedal > 45 && rpm > 1800 && coolant_temp > 70", "value": "knock_retard_worst", "stat": "p95", "settle_s": 0.5, "min_time_s": 6, "unit": "°", "dec": 1,
      "levels": [ { "severity": "critical", "gt": 8 }, { "severity": "warning", "gt": 5 }, { "severity": "advisory", "gt": 3.5 } ],
      "summary": "Under load the engine pulled up to {value}° of timing to stop knock.",
      "ok": "Knock control is quiet (up to {value}° under load).",
      "detail": "A little knock retard is normal. Consistently large corrections mean the engine is protecting itself and giving up power.",
      "causes": [ "Low-octane or poor fuel", "Carbon build-up on intake valves and pistons", "Hot intake air (see charge temperature)", "Worn spark plugs or wrong heat range", "Oil dilution or low oil quality" ] },
    { "id": "knock_one_cylinder", "title": "One cylinder knocks more than the others", "category": "Ignition",
      "when": "accel_pedal > 45 && rpm > 1800 && coolant_temp > 70", "value": "knock_retard_spread", "stat": "p90", "settle_s": 0.5, "min_time_s": 6, "unit": "°", "dec": 1,
      "levels": [ { "severity": "warning", "gt": 4.5 }, { "severity": "advisory", "gt": 3 } ],
      "summary": "One cylinder is pulling {value}° more timing than the quietest one.",
      "ok": "All cylinders knock-correct alike (spread {value}°).",
      "detail": "When a single cylinder stands out, the cause is local to it.",
      "causes": [ "Spark plug or ignition coil on that cylinder", "Injector spray pattern or flow", "Carbon deposits in that cylinder" ] },
    { "id": "misfires", "title": "Misfires", "category": "Ignition",
      "when": "rpm > 500", "value": "misfire_total", "stat": "max", "min_time_s": 60, "unit": "", "dec": 0,
      "levels": [ { "severity": "critical", "gt": 60 }, { "severity": "warning", "gt": 12 }, { "severity": "advisory", "gt": 2 } ],
      "summary": "The engine counted up to {value} misfires.",
      "ok": "No misfires counted.",
      "detail": "Misfires send unburned fuel into the catalyst. A flashing check-engine light means stop driving hard now.",
      "causes": [ "Ignition coil or spark plug", "Injector", "Intake leak", "Carbon build-up on intake valves", "Low compression" ] },
    { "id": "chain_stretch_intake", "title": "Timing chain stretch", "category": "Valve timing",
      "when": "rpm > 500", "value": "abs(cam_adapt_in)", "stat": "last", "min_time_s": 5, "unit": "°", "dec": 1,
      "levels": [ { "severity": "critical", "gt": 5.5 }, { "severity": "warning", "gt": 4 }, { "severity": "advisory", "gt": 3 } ],
      "summary": "The engine has shifted intake cam timing by {value}° to make up for chain wear.",
      "ok": "Cam adaptation is {value}°, well inside the limit.",
      "detail": "The engine computer learns how far the camshaft has drifted from the crankshaft as the chain and tensioner wear. Volkswagen's replacement limit is about 4° on these engines, and correlation faults (P0016) appear near 6°. Watch the trend week to week: a chain does not un-stretch.",
      "causes": [ "Timing chain elongation", "Chain tensioner", "Worn guides or sprockets" ] },
    { "id": "chain_stretch_exhaust", "title": "Exhaust cam adaptation", "category": "Valve timing",
      "when": "rpm > 500", "value": "abs(cam_adapt_ex)", "stat": "last", "min_time_s": 5, "unit": "°", "dec": 1,
      "levels": [ { "severity": "warning", "gt": 5 }, { "severity": "advisory", "gt": 3.5 } ],
      "summary": "Exhaust cam timing has been shifted by {value}°.",
      "ok": "Exhaust cam adaptation is {value}°.",
      "detail": "The same learning as the intake side, for the exhaust camshaft.",
      "causes": [ "Timing chain elongation", "Chain tensioner" ] },
    { "id": "cam_tracking", "title": "Cam timing not following its target", "category": "Valve timing",
      "when": "rpm > 1500 && coolant_temp > 70", "value": "abs(cam_in_actual - cam_in_target)", "stat": "p95", "min_time_s": 60, "unit": "°", "dec": 1,
      "levels": [ { "severity": "warning", "gt": 8 }, { "severity": "advisory", "gt": 5 } ],
      "summary": "The intake cam lagged its target by up to {value}°.",
      "ok": "Intake cam follows its target (within {value}°).",
      "detail": "The variable valve timing adjuster is slow or not reaching position.",
      "causes": [ "Cam adjuster solenoid (magnet)", "Low or dirty oil", "Cam adjuster itself" ] },
    { "id": "rail_pressure_low", "title": "Fuel rail pressure below target", "category": "Fuel delivery",
      "when": "rpm > 1500 && engine_load > 40 && rail_pressure_target > 3000", "value": "(rail_pressure_target - rail_pressure) / rail_pressure_target * 100", "stat": "p90", "settle_s": 1.5, "min_time_s": 10, "unit": "%", "dec": 0,
      "levels": [ { "severity": "critical", "gt": 25 }, { "severity": "warning", "gt": 15 }, { "severity": "advisory", "gt": 9 } ],
      "summary": "Fuel rail pressure fell {value} % short of target under load.",
      "ok": "Fuel rail pressure follows its target (within {value} %).",
      "detail": "The high-pressure fuel system is not keeping up with demand.",
      "causes": [ "High-pressure fuel pump", "Low-side pump or filter not feeding it", "Fuel pressure regulator valve", "Leaking injector" ] },
    { "id": "lp_fuel_low", "title": "Low-side fuel pressure low", "category": "Fuel delivery",
      "when": "rpm > 600", "value": "lp_fuel_pressure", "stat": "min", "min_time_s": 60, "unit": "kPa", "dec": 0,
      "levels": [ { "severity": "critical", "lt": 250 }, { "severity": "warning", "lt": 330 } ],
      "summary": "Low-side fuel pressure dropped to {value} kPa.",
      "ok": "Low-side fuel pressure stays above {value} kPa.",
      "detail": "The in-tank pump feeds the high-pressure pump. If it sags, the engine leans out under load.",
      "causes": [ "In-tank fuel pump", "Fuel pump control module", "Clogged fuel filter" ] }
  ]
}
